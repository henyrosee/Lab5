# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
APP_URL=http://localhost/LavaLust/public/

# Database Configuration
DB_DRIVER=mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=mydb
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_SSL_CA=

# First-run login account (set these in Render Environment Variables)
ADMIN_EMAIL=
ADMIN_PASSWORD=
